# Sepolia RPC URL (get from Infura, Alchemy, or public endpoint)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/k8_LhgwjujU0F1YPlCXRA

# Etherscan API Key (get from https://sepolia.etherscan.io/myapikey)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Deployer private key (DO NOT commit this to git!)
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Timelock delay in days
TIMELOCK_DELAY_DAYS=2

# Multisig signer addresses (comma-separated, eligible H1/H2 citizens)
# These will receive Founder-tier (tier=3), Phase 1 (H1) NFTs
UPGRADE_SIGNERS=0x...,0x...,0x...,0x...,0x...
PAUSE_SIGNERS=0x...,0x...,0x...
TREASURY_SIGNERS=0x...,0x...,0x...,0x...,0x...
JURY_SIGNERS=0x...,0x...,0x...,0x...,0x...
